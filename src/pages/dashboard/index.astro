---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
---

<Layout 
  title="Dashboard Analytics - Marketing Pro"
  description="Panel de control con métricas de rendimiento, análisis de tráfico, conversiones y KPIs principales de marketing digital."
>
  <Header client:load />
  
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Dashboard Header -->
      <div class="mb-8">
        <h1 class="font-display text-3xl font-bold text-gray-900 dark:text-white mb-2">
          Dashboard Analytics
        </h1>
        <p class="text-gray-600 dark:text-gray-300">
          Monitorea el rendimiento de tus estrategias de marketing digital
        </p>
      </div>

      <!-- Quick Stats -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Visitantes Únicos</p>
              <p class="text-2xl font-bold text-gray-900 dark:text-white">24,543</p>
              <p class="text-sm text-green-600">↗ +12.5%</p>
            </div>
            <div class="p-3 bg-blue-500 rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Conversiones</p>
              <p class="text-2xl font-bold text-gray-900 dark:text-white">1,247</p>
              <p class="text-sm text-green-600">↗ +18.2%</p>
            </div>
            <div class="p-3 bg-green-500 rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 dark:text-gray-400">Ingresos</p>
              <p class="text-2xl font-bold text-gray-900 dark:text-white">€45,290</p>
              <p class="text-sm text-green-600">↗ +8.1%</p>
            </div>
            <div class="p-3 bg-purple-500 rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
              </svg>
            </div>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-600 dark:text-gray-400">ROI</p>
              <p class="text-2xl font-bold text-gray-900 dark:text-white">285%</p>
              <p class="text-sm text-green-600">↗ +15.7%</p>
            </div>
            <div class="p-3 bg-orange-500 rounded-lg">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Traffic Chart -->
        <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Tráfico del Sitio Web
          </h2>
          <div class="h-64 flex items-center justify-center text-gray-500">
            <p>Gráfico de tráfico (integración con Recharts pendiente)</p>
          </div>
        </div>

        <!-- Top Pages -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Páginas Más Visitadas
          </h2>
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <div>
                <p class="font-medium text-gray-900 dark:text-white">/blog/seo-guide-2024</p>
                <p class="text-sm text-gray-500">15,420 vistas</p>
              </div>
              <span class="text-green-600 text-sm">+8%</span>
            </div>
            <div class="flex justify-between items-center">
              <div>
                <p class="font-medium text-gray-900 dark:text-white">/herramientas</p>
                <p class="text-sm text-gray-500">8,930 vistas</p>
              </div>
              <span class="text-green-600 text-sm">+12%</span>
            </div>
            <div class="flex justify-between items-center">
              <div>
                <p class="font-medium text-gray-900 dark:text-white">/servicios</p>
                <p class="text-sm text-gray-500">5,670 vistas</p>
              </div>
              <span class="text-red-600 text-sm">-3%</span>
            </div>
            <div class="flex justify-between items-center">
              <div>
                <p class="font-medium text-gray-900 dark:text-white">/</p>
                <p class="text-sm text-gray-500">4,230 vistas</p>
              </div>
              <span class="text-green-600 text-sm">+6%</span>
            </div>
          </div>
        </div>

        <!-- Conversion Funnel -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Embudo de Conversión
          </h2>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-gray-600 dark:text-gray-400">Visitantes</span>
              <span class="font-semibold text-gray-900 dark:text-white">24,543</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-600 h-2 rounded-full" style="width: 100%"></div>
            </div>
            
            <div class="flex items-center justify-between">
              <span class="text-gray-600 dark:text-gray-400">Interacciones</span>
              <span class="font-semibold text-gray-900 dark:text-white">8,920</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-600 h-2 rounded-full" style="width: 36%"></div>
            </div>
            
            <div class="flex items-center justify-between">
              <span class="text-gray-600 dark:text-gray-400">Leads</span>
              <span class="font-semibold text-gray-900 dark:text-white">2,450</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-600 h-2 rounded-full" style="width: 10%"></div>
            </div>
            
            <div class="flex items-center justify-between">
              <span class="text-gray-600 dark:text-gray-400">Conversiones</span>
              <span class="font-semibold text-gray-900 dark:text-white">1,247</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-green-600 h-2 rounded-full" style="width: 5%"></div>
            </div>
          </div>
        </div>

        <!-- Traffic Sources -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Fuentes de Tráfico
          </h2>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
                <span class="text-gray-600 dark:text-gray-400">Orgánico</span>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white">45%</span>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                <span class="text-gray-600 dark:text-gray-400">Directo</span>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white">28%</span>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-purple-500 rounded-full mr-3"></div>
                <span class="text-gray-600 dark:text-gray-400">Social Media</span>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white">15%</span>
            </div>
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div class="w-3 h-3 bg-orange-500 rounded-full mr-3"></div>
                <span class="text-gray-600 dark:text-gray-400">PPC</span>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white">12%</span>
            </div>
          </div>
        </div>

        <!-- Recent Activity -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Actividad Reciente
          </h2>
          <div class="space-y-4">
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-green-500 rounded-full mt-2"></div>
              <div>
                <p class="text-sm text-gray-900 dark:text-white">Nueva conversión desde Google Ads</p>
                <p class="text-xs text-gray-500">Hace 5 minutos</p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-blue-500 rounded-full mt-2"></div>
              <div>
                <p class="text-sm text-gray-900 dark:text-white">Nuevo suscriptor al newsletter</p>
                <p class="text-xs text-gray-500">Hace 12 minutos</p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-purple-500 rounded-full mt-2"></div>
              <div>
                <p class="text-sm text-gray-900 dark:text-white">Artículo compartido en LinkedIn</p>
                <p class="text-xs text-gray-500">Hace 25 minutos</p>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-orange-500 rounded-full mt-2"></div>
              <div>
                <p class="text-sm text-gray-900 dark:text-white">Nuevo lead desde formulario</p>
                <p class="text-xs text-gray-500">Hace 45 minutos</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer client:load />
</Layout>