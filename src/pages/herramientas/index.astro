---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import ROICalculator from '../../components/tools/ROICalculator';
---

<Layout 
  title="Herramientas de Marketing Digital Gratuitas - Marketing Pro"
  description="Herramientas gratuitas de marketing digital: calculadora ROI, generador meta tags, analizador keywords y más. Optimiza tus campañas digitales."
>
  <Header client:load />
  
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header -->
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-6">
          Herramientas de Marketing
          <span class="block text-primary-500">Digital</span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Suite completa de herramientas profesionales para optimizar tus estrategias de marketing digital
        </p>
      </div>

      <!-- Tools Navigation -->
      <div class="mb-12">
        <div class="border-b border-gray-200 dark:border-gray-700">
          <nav class="-mb-px flex space-x-8 justify-center">
            <button 
              class="tool-tab py-4 px-1 border-b-2 font-medium text-sm border-primary-500 text-primary-600"
              data-tool="roi-calculator"
            >
              Calculadora ROI
            </button>
            <button 
              class="tool-tab py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300"
              data-tool="meta-generator"
            >
              Generador Meta Tags
            </button>
            <button 
              class="tool-tab py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300"
              data-tool="keyword-analyzer"
            >
              Analizador Keywords
            </button>
            <button 
              class="tool-tab py-4 px-1 border-b-2 border-transparent font-medium text-sm text-gray-500 hover:text-gray-700 hover:border-gray-300"
              data-tool="hashtag-generator"
            >
              Generador Hashtags
            </button>
          </nav>
        </div>
      </div>

      <!-- Tool Content -->
      <div id="tool-content">
        <div id="roi-calculator" class="tool-content">
          <ROICalculator client:load />
        </div>
        
        <div id="meta-generator" class="tool-content hidden">
          <div class="text-center py-20">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              Generador de Meta Tags
            </h2>
            <p class="text-gray-600 dark:text-gray-400">
              Esta herramienta está en desarrollo. Próximamente disponible.
            </p>
          </div>
        </div>
        
        <div id="keyword-analyzer" class="tool-content hidden">
          <div class="text-center py-20">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              Analizador de Keywords
            </h2>
            <p class="text-gray-600 dark:text-gray-400">
              Esta herramienta está en desarrollo. Próximamente disponible.
            </p>
          </div>
        </div>
        
        <div id="hashtag-generator" class="tool-content hidden">
          <div class="text-center py-20">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              Generador de Hashtags
            </h2>
            <p class="text-gray-600 dark:text-gray-400">
              Esta herramienta está en desarrollo. Próximamente disponible.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <Footer client:load />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toolTabs = document.querySelectorAll<HTMLButtonElement>('.tool-tab');
    const toolContents = document.querySelectorAll<HTMLElement>('.tool-content');
      
    toolTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const tool = tab.getAttribute('data-tool');
        if (!tool) return;
        
        // Update tab states
        toolTabs.forEach((t) => {
          t.classList.remove('border-primary-500', 'text-primary-600');
          t.classList.add('border-transparent', 'text-gray-500');
        });
        tab.classList.remove('border-transparent', 'text-gray-500');
        tab.classList.add('border-primary-500', 'text-primary-600');
        
        // Update content visibility
        toolContents.forEach((content) => {
          content.classList.add('hidden');
        });
        const target = document.getElementById(tool);
        if (target) target.classList.remove('hidden');
      });
    });
  });
</script>
</Layout>