---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import Footer from '../../components/layout/Footer';
import BlogCard from '../../components/blog/BlogCard';
import { getAllPosts } from '../../services/postsService';
import { getAllCategories } from '../../services/categoriesService';
import type { Post } from '../../types';

// Función para adaptar Post del backend al formato BlogPost del componente
function adaptPostToBlogPost(post: Post) {
  return {
    id: post.id.toString(),
    title: post.title,
    excerpt: post.excerpt || post.content?.substring(0, 200) || '',
    slug: post.slug,
    publishedAt: post.publishedAt || post.createdAt,
    readTime: post.readTime || 5,
    author: {
      name: post.author?.name || 'Autor',
      avatar: post.author?.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(post.author?.name || 'A')}`
    },
    category: {
      name: post.category?.name || 'General',
      color: post.category?.color || '#3B82F6'
    },
    image: post.featuredImage || 'https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=800',
    tags: post.tags || []
  };
}

// Obtener posts publicados del backend
const allPosts = await getAllPosts();
const publishedPosts = allPosts.filter((post: Post) => post.status === 'published');

// Filtrar posts destacados y regulares
const featuredPosts = publishedPosts.filter((post: Post) => post.featured).map(adaptPostToBlogPost);
const regularPosts = publishedPosts.filter((post: Post) => !post.featured).map(adaptPostToBlogPost);

// Obtener y adaptar categorías del backend
const backendCategories = await getAllCategories();
const categories = backendCategories.map(cat => ({
  name: cat.name,
  slug: cat.slug,
  color: cat.color || '#3B82F6'
}));
---

<Layout 
  title="Blog de Marketing Digital - Guías y Estrategias Avanzadas"
  description="Descubre las últimas tendencias, estrategias y herramientas de marketing digital. Guías completas de SEO, SEM, Social Media, Content Marketing y más."
>
  <Header client:load />
  
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <!-- Hero Section -->
    <section class="bg-white dark:bg-gray-900 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Blog de Marketing
            <span class="block text-primary-500">Digital</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8">
            Descubre las últimas tendencias, estrategias probadas y herramientas que están transformando el marketing digital
          </p>
        </div>
      </div>
    </section>

    <!-- Filters Section -->
    <section class="py-8 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map((category) => (
            <button
              class="filter-btn px-6 py-2 rounded-full border text-sm font-medium transition-all duration-200 hover:scale-105"
              data-category={category.slug}
              style={`border-color: ${category.color}; color: ${category.color}`}
            >
              {category.name}
            </button>
          ))}
        </div>
        
        <!-- Search Bar -->
        <div class="mt-8 max-w-md mx-auto">
          <div class="relative">
            <input
              id="search-input"
              type="text"
              placeholder="Buscar artículos..."
              class="w-full px-4 py-3 pl-12 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent dark:bg-gray-800 dark:text-white"
            />
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Posts -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
          Artículos Destacados
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
          {featuredPosts.map((post, index) => (
            <a href={`/blog/${post.slug}`} class="block">
              <BlogCard 
                post={post} 
                featured={index === 0} 
                client:load 
              />
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Regular Posts -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-3xl font-bold text-gray-900 dark:text-white mb-12 text-center">
          Todos los Artículos
        </h2>
        
        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {regularPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="block" data-category={post.category.name}>
              <BlogCard post={post} client:load />
            </a>
          ))}
        </div>
        
        <!-- No Results Message -->
        <div id="no-results" class="hidden text-center py-16">
          <div class="text-gray-500 dark:text-gray-400">
            <svg class="mx-auto h-12 w-12 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 class="text-lg font-medium mb-2">No se encontraron artículos</h3>
            <p>Prueba con otros términos de búsqueda o selecciona una categoría diferente.</p>
          </div>
        </div>

        <!-- Load More Button -->
        <div class="text-center mt-12">
          <button
            id="load-more"
            class="px-8 py-3 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-colors duration-200 font-medium"
          >
            Cargar Más Artículos
          </button>
        </div>
      </div>
    </section>
  </main>
  
  <Footer client:load />
</Layout>

<script>
  // Blog filtering and search functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const postsGrid = document.getElementById('posts-grid') as HTMLElement | null;
    const noResults = document.getElementById('no-results') as HTMLElement | null;
    const loadMoreBtn = document.getElementById('load-more') as HTMLButtonElement | null;
    
    let currentFilter: string = 'all';
    let searchTerm = '';
    let visiblePosts = 9;
    
    // Filter functionality
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category') ?? 'all';
        currentFilter = category;
        
        // Update button states
        filterButtons.forEach((btn) => {
          const btnCategory = btn.getAttribute('data-category');
          const btnColor = (btn as HTMLButtonElement).style.color;
          
          if (btnCategory === category) {
            (btn as HTMLButtonElement).style.backgroundColor = btnColor;
            (btn as HTMLButtonElement).style.color = 'white';
          } else {
            (btn as HTMLButtonElement).style.backgroundColor = 'transparent';
            (btn as HTMLButtonElement).style.color = btnColor;
          }
        });
        
        filterAndSearchPosts();
      });
    });
    
    // Search functionality
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement | null;
        const val = target?.value ?? '';
        searchTerm = val.toLowerCase();
        visiblePosts = 9;
        filterAndSearchPosts();
      });
    }
    
    function filterAndSearchPosts() {
      if (!postsGrid) return;
      const posts = postsGrid.querySelectorAll('a') as NodeListOf<HTMLAnchorElement>;
      let visibleCount = 0;
      let totalVisible = 0;
      
      posts.forEach((post) => {
        const category = post.getAttribute('data-category') ?? '';
        const title = (post.querySelector('h3')?.textContent ?? '').toLowerCase();
        const excerpt = (post.querySelector('p')?.textContent ?? '').toLowerCase();
        
        const matchesCategory = currentFilter === 'all' || category === currentFilter;
        const matchesSearch = searchTerm === '' || 
          title.includes(searchTerm) || 
          excerpt.includes(searchTerm);
        
        if (matchesCategory && matchesSearch) {
          totalVisible++;
          if (visibleCount < visiblePosts) {
            post.style.display = 'block';
            visibleCount++;
          } else {
            post.style.display = 'none';
          }
        } else {
          post.style.display = 'none';
        }
      });
      
      // Show/hide no results message
      if (noResults && loadMoreBtn) {
        if (totalVisible === 0) {
          noResults.classList.remove('hidden');
          loadMoreBtn.style.display = 'none';
        } else {
          noResults.classList.add('hidden');
          loadMoreBtn.style.display = totalVisible > visiblePosts ? 'block' : 'none';
        }
      }
    }
    
    // Load more functionality
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        visiblePosts += 6;
        filterAndSearchPosts();
      });
    }
    
    // Initialize first filter button as active
    if (filterButtons.length > 0) {
      const firstBtn = filterButtons[0];
      firstBtn.style.backgroundColor = firstBtn.style.color;
      firstBtn.style.color = 'white';
    }
  });
</script>
</Layout>